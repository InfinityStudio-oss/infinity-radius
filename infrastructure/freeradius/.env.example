# RADIUS PostgreSQL connection — consumed by raddb/mods-available/sql via
# $ENV{...} and by docker-compose.yml for local dev. Never put real
# values in this file; copy to .env next to docker-compose.yml.

RADIUS_DB_HOST=radius-postgres
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=

# WireGuard interface address FreeRADIUS binds to — never 0.0.0.0 in
# production (see raddb/sites-available/default).
RADIUS_LISTEN_ADDR=10.90.0.1
