# --- Application ---
APP_NAME="Infinity Radius API"
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Localization ---
DEFAULT_COUNTRY_CODE=TZ
DEFAULT_CURRENCY=TZS
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_LOCALE=en-TZ

# --- Primary database (Supabase Postgres, async driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/infinity_radius

# --- Migration safety (app/core/migration_safety.py, alembic/env.py) ---
# Required (set to true) only for the single command/job that runs a real
# production migration — unset immediately afterward. Never leave this
# true permanently on any service. See docs/architecture.md#migration-safety.
ALLOW_PRODUCTION_MIGRATIONS=false
# Explicit override for the migration-target classifier — almost never
# needed; leave unset unless the hostname heuristic gets a genuinely-safe
# non-localhost target wrong (e.g. local/test/staging/production).
DATABASE_MIGRATION_TARGET=

# --- RADIUS database (Postgres on the Network VPS in production — FreeRADIUS
# schema; a local Postgres database during development). Separate from
# DATABASE_URL above; never point this at Supabase. Locally, run
# `python -m scripts.setup_local_radius_db` from apps/api to create the
# `radius` database, a least-privilege `radius_app` role, and apply the
# schema — it writes the real local password into this file for you, so
# CHANGE_ME below is only a placeholder for the shape of the value. ---
RADIUS_DATABASE_URL=postgresql+asyncpg://radius_app:CHANGE_ME@localhost:5432/radius

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# JWKS endpoint — Settings -> API -> JWT Keys (the modern JWT Signing Keys
# system). Typically:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# The backend verifies every request's Authorization: Bearer token against
# these published public keys — never a shared secret.
SUPABASE_JWKS_URL=
# Secret key (the modern replacement for the legacy service_role key) —
# Settings -> API -> API Keys. Grants full admin access (bypasses RLS);
# needed only for OnboardingService to create the Supabase Auth user
# server-side. NEVER expose this to a browser/frontend build.
SUPABASE_SECRET_KEY=

# --- Public application URL (used to build links in transactional emails) ---
APP_URL=http://localhost:3000

# --- Resend (transactional email: client verification + Super Admin
# onboarding notices) — https://resend.com/api-keys. Sending domain must
# already be verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Infinity Radius"
# Where "new tenant awaiting approval" notifications are sent.
SUPER_ADMIN_REVIEW_EMAIL=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Network Agent (reached over HTTPS; the agent itself talks WireGuard to routers) ---
NETWORK_AGENT_BASE_URL=
NETWORK_AGENT_API_KEY=

# --- Secrets at rest (router RADIUS secrets, WireGuard private keys) and the
# signed public router token (captive-portal redirects) — two DIFFERENT
# Fernet keys, each required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
ROUTER_TOKEN_SIGNING_KEY=
TRANSACTION_TOKEN_SIGNING_KEY=

# --- Walled garden platform domains — the exact hosts a hotspot's walled
# garden must allow (captive portal UI + public payment/status API), never
# a wildcard. See app/services/router_provisioning.py.
PUBLIC_CAPTIVE_PORTAL_DOMAIN=
PUBLIC_API_DOMAIN=

# --- WireGuard server (the Network VPS's own wg0.conf — see
# infrastructure/wireguard/) — needed to generate a complete router-side
# config in the Add Router Wizard. Real values come only from `wg genkey`/
# `wg pubkey` run on the actual Network VPS (infrastructure/scripts/
# provision-vps.sh) — never invented here. The server's PRIVATE key is
# never an application env var; it stays in /etc/wireguard/wg0.conf on the
# VPS only.
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_SERVER_ENDPOINT=vpn.example.com:51820
WIREGUARD_SERVER_SUBNET=10.90.0.0/24

# --- Selcom (Collection API) — placeholders until official docs/credentials are supplied.
# NOT used for disbursement — see SELCOM_BUSINESS_* below for that. ---
SELCOM_API_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_MERCHANT_ID=
# Explicit business/legal approval gate for Disbursement — separate from
# having credentials configured above. Leave false until Infinity Radius
# has approved the disbursement model for real money movement.
SELCOM_DISBURSEMENT_ENABLED=false

# --- Selcom Business API (developer.selcom.business) — real disbursement
# transport, RSA-SHA256 signed. See app/integrations/selcom_business/. ---
# "sandbox" or "production" — never production without first confirming
# signature/lookup/process/query/callback all work in sandbox.
SELCOM_BUSINESS_ENVIRONMENT=sandbox
# Origin only, e.g. https://sandbox.selcom.business — never include a
# trailing /v1 (the client appends the full /v1/... path itself, and
# defensively strips one if present anyway).
SELCOM_BUSINESS_BASE_URL=
SELCOM_BUSINESS_API_KEY=
# PEM-encoded RSA private key, base64-encoded so the multiline PEM block
# survives being pasted into a single-line env var:
#   base64 -w0 selcom_business_private_key.pem
# Decode with base64.b64decode(...).decode() to recover the real PEM.
# NEVER commit a real value here — Railway Variables only.
SELCOM_BUSINESS_PRIVATE_KEY_B64=
# Only needed if the Balance endpoint is used (Super Admin provider-health
# visibility) — never the tenant wallet balance.
SELCOM_BUSINESS_ACCOUNT_NUMBER=
# THIRD, independent gate on real money movement (see
# app/services/payouts.py._submit_to_selcom) — a real production
# disbursement requires ALL THREE: SELCOM_BUSINESS_ENVIRONMENT=production
# AND SELCOM_DISBURSEMENT_ENABLED=true AND this. Leave false — including
# during initial production credential setup — until an operator is
# deliberately ready for the very first real payout (see
# docs/architecture.md's production activation runbook).
SELCOM_PRODUCTION_PAYOUTS_ENABLED=false

# --- Withdrawal approval threshold (app/services/payouts.py) ---
# amount <= this: no Super Admin approval, proceeds straight to Selcom
# once 2FA confirms. amount > this: PENDING_APPROVAL until a SUPER_ADMIN
# approves or rejects it. Server-side only — never a frontend control.
SELCOM_WITHDRAWAL_APPROVAL_THRESHOLD_TZS=100000

# --- Withdrawal safety limits (app/services/payouts.py) — no product
# policy has been decided on these yet, so every one defaults to unset/
# disabled. Set a value only once an operator has made a real decision. ---
WITHDRAWAL_MIN_AMOUNT_TZS=
WITHDRAWAL_MAX_SINGLE_AMOUNT_TZS=
WITHDRAWAL_DAILY_LIMIT_TZS=
WITHDRAWAL_DAILY_COUNT_LIMIT=

# --- Stale withdrawal alerting (app/tasks/reconciliation.py) — a
# withdrawal stuck PROCESSING/AMBIGUOUS longer than these thresholds gets
# ONE Super Admin email via Resend, then respects the cooldown. ---
WITHDRAWAL_PROCESSING_ALERT_MINUTES=30
WITHDRAWAL_AMBIGUOUS_ALERT_MINUTES=15
WITHDRAWAL_STALE_ALERT_COOLDOWN_MINUTES=60

# --- Withdrawal OTP (app/services/two_factor.py) ---
# HMAC key the withdrawal OTP is hashed with before storage — never a bare
# hash of the 6-digit code (too small a keyspace to be safe unkeyed).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real value here — Railway Variables only, and only the
# web service needs it (OTP verification is synchronous, never done by
# the Celery worker/beat).
OTP_VERIFICATION_SECRET=
# Defaults shown are also the code defaults — override only if needed.
WITHDRAWAL_OTP_TTL_SECONDS=600
WITHDRAWAL_OTP_MAX_ATTEMPTS=5
WITHDRAWAL_OTP_RESEND_COOLDOWN_SECONDS=60
WITHDRAWAL_OTP_MAX_SENDS=5
