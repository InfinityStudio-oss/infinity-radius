# Supabase (client-safe, exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend (Railway), reached from the browser/server for tenant-scoped API calls
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "development" | "staging" | "production"
NEXT_PUBLIC_APP_ENV=development

# Server-only: used by Next.js server actions/route handlers that need elevated
# Supabase access. NEVER prefix with NEXT_PUBLIC_ and never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
