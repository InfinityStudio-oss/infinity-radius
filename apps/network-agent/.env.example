ENVIRONMENT=development
HOST=0.0.0.0
PORT=8100

# --- Request signing (see app/core/security.py) ---
# The FastAPI backend HMAC-signs every request with one of these. Rotate
# by generating a new AGENT_API_KEY_CURRENT, moving the old value into
# AGENT_API_KEY_PREVIOUS, deploying, updating the backend's key, then
# clearing AGENT_API_KEY_PREVIOUS once every caller is confirmed on the
# new key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEY_CURRENT=
AGENT_API_KEY_PREVIOUS=

# Signed requests older/newer than this (seconds) are rejected.
REQUEST_MAX_SKEW_SECONDS=300
# Must be >= 2x REQUEST_MAX_SKEW_SECONDS.
NONCE_CACHE_TTL_SECONDS=600

# --- Source IP allowlist (Railway static outbound IPs) ---
# Comma-separated IPs/CIDRs. Required in production — see
# app/core/ip_allowlist.py (an empty value is tolerated in development only).
ALLOWED_SOURCE_IPS=

# --- Router registry (see app/core/router_registry.py) ---
ROUTER_REGISTRY_PATH=routers.yaml

# --- MikroTik RouterOS API ---
# ssl_verify=false is refused outside development (see
# NetworkAgentSettings._forbid_insecure_mikrotik_tls_in_production).
MIKROTIK_USE_SSL=true
MIKROTIK_SSL_VERIFY=true
MIKROTIK_CONNECT_TIMEOUT_SECONDS=5

# WireGuard interface used to reach router private IPs (configured by
# infrastructure/wireguard — see that directory's README).
WIREGUARD_INTERFACE=wg0

# Local Postgres systemd service name backing the RADIUS database on this
# VPS — checked by /health via `systemctl is-active`, the same
# credential-free process check already used for freeradius itself. Change
# only if your distro names the service differently (e.g. postgresql@16-main).
RADIUS_DB_SERVICE_NAME=postgresql

# Connection string for the LOCAL FreeRADIUS PostgreSQL on this VPS, used
# to provision paying customers' RADIUS credentials (see
# app/services/radius_provisioning.py and app/routers/radius.py).
#
# ALWAYS a localhost or unix-socket DSN. This setting is precisely what
# makes exposing the RADIUS database to the internet unnecessary — the
# backend asks this agent to provision instead of connecting itself — so
# pointing it at a public host would defeat its entire purpose.
#
# Leave unset to disable provisioning: /radius/ping then reports
# unreachable and the backend records activation as FAILED and retries,
# rather than half-completing.
RADIUS_DATABASE_DSN=postgresql://radius:CHANGE_ME@127.0.0.1:5432/radius
